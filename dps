    print(f"\n{SKY_BLUE}╭─ {BOLD}{ELECTRIC_CYAN}󰡨 Docker Container Inspection: {WHITE}{name}{SKY_BLUE} {'─' * max(2, box_w - len(name) - 34)}╮{RESET}")
