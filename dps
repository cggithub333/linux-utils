            print(f"{SKY_BLUE}│{RESET}    • {MUTED}[{m_type}/{rw}]{RESET} {WHITE}{src}{RESET} {SKY_BLUE}→{RESET} {ELECTRIC_CYAN}{dst}{RESET}")

    # Top Environment Variables
