            if "=" in ev:
                k, v = ev.split("=", 1)
                if any(sec in k.lower() for sec in ["secret", "pass", "key", "token"]):
                    v = "******"
                print(f"{SKY_BLUE}│{RESET}    • {BOLD}{ELECTRIC_CYAN}{k}{RESET}={WHITE}{v}{RESET}")
        if len(env_vars) > 12:
            print(f"{SKY_BLUE}│{RESET}    {GRAY}… and {len(env_vars) - 12} more environment variables{RESET}")

    print(f"{SKY_BLUE}╰{'─' * box_w}╯{RESET}\n")

# --- Interactive FZF Mode ---
def run_fzf_mode(containers):
    script_path = os.path.realpath(__file__)
    fzf_header = f"{BOLD}{ELECTRIC_CYAN}  {'NO':<4} {'ID':<12} {'STATE':<10} {'NAME':<28} {'STACK':<16} {'IMAGE':<24} PORTS{RESET}"
    lines = [fzf_header]

    for idx, c in enumerate(containers, 1):
        line = f"  {idx:<4} {c['short_id']:<12} {c['state']:<10} {c['name']:<28} {(c['stack'] or '—'):<16} {c['image'][:23]:<24} {c['ports']}"
        lines.append(line)

    preview_cmd = f"{script_path} --fzf-preview {{2}}"

    fzf_cmd = [
        "fzf",
        "--ansi",
        "--header-lines=1",
        "--layout=reverse",
        "--border=rounded",
        "--prompt=󰡨 Docker Explorer > ",
        "--header=[Enter] View Logs  │  [Ctrl-S] Start  │  [Ctrl-T] Stop  │  [Ctrl-R] Restart  │  [Ctrl-E] Exec Shell  │  [Ctrl-K] Kill",
        f"--preview={preview_cmd}",
        "--preview-window=right:55%:wrap:border-rounded",
        "--bind=shift-up:preview-up",
        "--bind=shift-down:preview-down",
        "--bind=page-up:preview-page-up",
        "--bind=page-down:preview-page-down",
        f"--bind=ctrl-s:execute(docker start {{2}} >/dev/null 2>&1 && notify-send 'Docker Manager' 'Started container {{2}}')+reload({script_path} --fzf-dump)",
        f"--bind=ctrl-t:execute(docker stop {{2}} >/dev/null 2>&1 && notify-send 'Docker Manager' 'Stopped container {{2}}')+reload({script_path} --fzf-dump)",
        f"--bind=ctrl-r:execute(docker restart {{2}} >/dev/null 2>&1 && notify-send 'Docker Manager' 'Restarted container {{2}}')+reload({script_path} --fzf-dump)",
        f"--bind=ctrl-k:execute(docker kill {{2}} >/dev/null 2>&1 && notify-send 'Docker Manager' 'Killed container {{2}}')+reload({script_path} --fzf-dump)",
        f"--bind=ctrl-u:reload({script_path} --fzf-dump)",
        "--bind=ctrl-y:execute(echo -n {2} | wl-copy 2>/dev/null || echo -n {2} | xclip -sel clip 2>/dev/null)",
    ]

    try:
        proc = subprocess.Popen(
            fzf_cmd,
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            text=True
        )
        selected_line, _ = proc.communicate(input="\n".join(lines))
        if proc.returncode == 0 and selected_line.strip():
            clean_line = ANSI_STRIP_REGEX.sub('', selected_line).strip()
            tokens = clean_line.split()
            if len(tokens) >= 2:
                target_id = tokens[1]
                # If dlog exists in same folder or PATH, launch dlog
                dlog_path = os.path.join(os.path.dirname(script_path), "dlog")
                if os.path.exists(dlog_path) and os.access(dlog_path, os.X_OK):
                    os.execv(dlog_path, [dlog_path, target_id])
                else:
                    os.execvp("docker", ["docker", "logs", "-f", "--tail=100", target_id])
    except KeyboardInterrupt:
        pass

def fzf_preview(container_id):
    """
    Renders detailed inspection and the latest 35 log lines for FZF preview pane.
    """
    inspect_container(container_id)
    print(f"{BOLD}{ELECTRIC_CYAN}─── 󰈚 Recent Logs (tail 35) ──────────────────────────────────────{RESET}")
    try:
        proc = subprocess.run(["docker", "logs", "--tail=35", "--timestamps", container_id], capture_output=True, text=True)
        logs = proc.stdout or proc.stderr
        if logs.strip():
            print(logs.strip())
        else:
            print(f"{GRAY}(No recent log entries){RESET}")
    except Exception as e:
        print(f"{RED}Error fetching logs: {e}{RESET}")

def fzf_dump_lines():
    containers = collect_containers(all_containers=True)
    fzf_header = f"{BOLD}{ELECTRIC_CYAN}  {'NO':<4} {'ID':<12} {'STATE':<10} {'NAME':<28} {'STACK':<16} {'IMAGE':<24} PORTS{RESET}"
    print(fzf_header)
    for idx, c in enumerate(containers, 1):
        print(f"  {idx:<4} {c['short_id']:<12} {c['state']:<10} {c['name']:<28} {(c['stack'] or '—'):<16} {c['image'][:23]:<24} {c['ports']}")

# --- Main Entrypoint ---
def main():
    parser = argparse.ArgumentParser(
        description="dps: Universal Smart, Fast & Beautiful Docker Container Explorer & Process Viewer",
        formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument("-a", "--all", action="store_true", default=True, help="Show all containers (default: True)")
    parser.add_argument("-r", "--running", action="store_true", help="Show only running containers")
    parser.add_argument("-s", "--stopped", "--exited", dest="stopped", action="store_true", help="Show only stopped/exited containers")
    parser.add_argument("-p", "--project", "--stack", dest="project", help="Filter containers by Docker Compose project / stack")
    parser.add_argument("-q", "--search", help="Search across container names, IDs, images, ports, or stacks")
    parser.add_argument("-g", "--group", action="store_true", help="Group containers by Docker Compose project / stack")
    parser.add_argument("-n", "--limit", type=int, default=None, help="Limit number of containers displayed")
    parser.add_argument("-w", "--watch", nargs="?", const=2.0, type=float, help="Live auto-refresh watch dashboard with interval in seconds (default: 2.0s)")
    parser.add_argument("-i", "--fzf", "--interactive", action="store_true", help="Launch interactive FZF container browser with live preview and controls")
    parser.add_argument("-f", dest="fzf_alias", action="store_true", help="Alias for -i / --fzf")
    parser.add_argument("--inspect", help="Display comprehensive inspection card for a specific container name or ID")
    parser.add_argument("--sort", choices=["name", "status", "created", "image", "id", "stack", "project", "ports"], default="name", help="Sort containers by field (default: name)")
    parser.add_argument("--asc", action="store_true", help="Sort in ascending order")
    parser.add_argument("--desc", action="store_true", help="Sort in descending order")
    parser.add_argument("--json", action="store_true", help="Output machine-readable JSON")
    parser.add_argument("-c", "--color", choices=["auto", "always", "never"], default="auto", help="Color output mode (auto, always, never; default: auto)")
    parser.add_argument("--no-color", action="store_true", help="Disable ANSI color output")
    parser.add_argument("--fzf-dump", action="store_true", help=argparse.SUPPRESS)
    parser.add_argument("--fzf-preview", help=argparse.SUPPRESS)

    args = parser.parse_args()

    # Color configuration
    if args.color == "never" or args.no_color:
        disable_colors()
    elif args.color == "always":
        pass
    elif not sys.stdout.isatty() and not (args.json or args.inspect or args.fzf_dump or args.fzf_preview):
        disable_colors()

    # FZF Internal triggers
    if args.fzf_preview:
        fzf_preview(args.fzf_preview)
        return
    if args.fzf_dump:
        fzf_dump_lines()
        return

    # Consolidate fzf flag
    if getattr(args, "fzf_alias", False):
        args.fzf = True

    # Single Container Inspect Mode
    if args.inspect:
        inspect_container(args.inspect)
        return

    reverse_sort = args.desc if args.desc else (not args.asc if args.sort in ["created", "status"] else False)

    # Interactive FZF Mode
    if args.fzf:
        containers = collect_containers(
            all_containers=not args.running,
            search=args.search,
            running_only=args.running,
            stopped_only=args.stopped,
            project=args.project,
            sort_by=args.sort,
            reverse=reverse_sort
        )
        run_fzf_mode(containers)
        return

    # Live Watch Dashboard Mode
    if args.watch is not None:
        interval = max(0.5, args.watch)
        try:
            while True:
                containers = collect_containers(
                    all_containers=not args.running,
                    search=args.search,
                    running_only=args.running,
                    stopped_only=args.stopped,
                    project=args.project,
                    sort_by=args.sort,
                    reverse=reverse_sort
                )
                print(f"{ESC}[2J{ESC}[H", end="", flush=True)
                print_docker_header(containers, search=args.search, project=args.project, running_only=args.running, stopped_only=args.stopped)
                
                if args.group:
                    groups = group_containers_by_stack(containers)
                    render_grouped_table(groups, limit=args.limit)
                else:
                    render_table(containers, limit=args.limit)

                print(f"\n{GRAY}  󰔛 Refreshing every {interval:.1f}s │ Press Ctrl+C to exit{RESET}", flush=True)
                time.sleep(interval)
        except KeyboardInterrupt:
            print(f"\n{GRAY}Exited live watch mode.{RESET}")
            return

    # Standard Execution
    containers = collect_containers(
        all_containers=not args.running,
        search=args.search,
        running_only=args.running,
        stopped_only=args.stopped,
        project=args.project,
        sort_by=args.sort,
        reverse=reverse_sort
    )

    if args.json:
        payload = {
            "timestamp": datetime.datetime.now().isoformat(),
            "total": len(containers),
            "running": sum(1 for c in containers if c["state"].lower() == "running"),
            "exited": sum(1 for c in containers if c["state"].lower() == "exited"),
            "paused": sum(1 for c in containers if c["state"].lower() == "paused"),
            "results": containers if (args.limit is None) else containers[:args.limit]
        }
        print(json.dumps(payload, indent=2))
        return

    print_docker_header(containers, search=args.search, project=args.project, running_only=args.running, stopped_only=args.stopped)
    
    if args.group:
        groups = group_containers_by_stack(containers)
        render_grouped_table(groups, limit=args.limit)
    else:
        render_table(containers, limit=args.limit)

if __name__ == "__main__":
    main()
