    print(f"{SKY_BLUE}│{RESET}  {BOLD}Image:{RESET}          {WHITE}{image_name}{RESET}")
    print(f"{SKY_BLUE}│{RESET}  {BOLD}State / Status:{RESET} {GREEN if state_str == 'running' else RED}{state_str.upper()}{RESET} {GRAY}(PID: {pid}, ExitCode: {exit_code}){RESET}")
    if health_status != "none":
        h_color = BRIGHT_GREEN if health_status == "healthy" else (BRIGHT_RED if health_status == "unhealthy" else BRIGHT_YELLOW)
        print(f"{SKY_BLUE}│{RESET}  {BOLD}Health Check:{RESET}   {h_color}󰄬 {health_status}{RESET}")
    print(f"{SKY_BLUE}│{RESET}  {BOLD}Created At:{RESET}     {MUTED}{created}{RESET}")
    print(f"{SKY_BLUE}│{RESET}  {BOLD}Started At:{RESET}     {MUTED}{started_at}{RESET}")
    if state_str != "running" and finished_at:
        print(f"{SKY_BLUE}│{RESET}  {BOLD}Finished At:{RESET}    {MUTED}{finished_at}{RESET}")
    print(f"{SKY_BLUE}│{RESET}  {BOLD}Working Dir:{RESET}    {WHITE}{work_dir}{RESET}")
    print(f"{SKY_BLUE}│{RESET}  {BOLD}Command:{RESET}        {BRIGHT_YELLOW}{' '.join(cmd) if cmd else '—'}{RESET}")
    print(f"{SKY_BLUE}│{RESET}  {BOLD}Restart Policy:{RESET} {CYAN}{restart_policy}{RESET}")
    
    # Networks & IPs
    print(f"{SKY_BLUE}├{'─' * box_w}┤{RESET}")
    print(f"{SKY_BLUE}│{RESET}  {BOLD}{SKY_BLUE}󰛄 Networks & IP Addresses:{RESET}")
    for net_name, net_val in networks.items():
        ip = net_val.get("IPAddress", "")
        gw = net_val.get("Gateway", "")
