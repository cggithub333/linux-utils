def format_bytes(b):
    if b is None or b < 0:
        return "0 B"
    if b >= 1024**4:
        return f"{b / (1024**4):.2f} TB"
    if b >= 1024**3:
        return f"{b / (1024**3):.2f} GB"
    if b >= 1024**2:
        return f"{b / (1024**2):.1f} MB"
    if b >= 1024:
        return f"{b / 1024:.1f} KB"
    return f"{b} B"

def color_ram(b, pct=0.0, width=0):
    txt = format_bytes(b)
    aligned = f"{txt:>{width}}" if width > 0 else txt
    if b >= 1024**3 or pct >= 8.0:
        return f"{BOLD}{BRIGHT_RED}{aligned}{RESET}"
    elif b >= 500 * (1024**2) or pct >= 4.0:
        return f"{BOLD}{ORANGE}{aligned}{RESET}"
    elif b >= 150 * (1024**2) or pct >= 1.5:
        return f"{BRIGHT_YELLOW}{aligned}{RESET}"
    elif b >= 40 * (1024**2) or pct >= 0.5:
        return f"{ELECTRIC_CYAN}{aligned}{RESET}"
    elif b >= 5 * (1024**2):
        return f"{GREEN}{aligned}{RESET}"
    else:
        return f"{GRAY}{aligned}{RESET}"

CURRENT_USER = os.environ.get("USER") or (os.getlogin() if hasattr(os, "getlogin") else None) or ""

def color_user(uname, width=12):
    user_raw = str(uname) if uname is not None else "unknown"
    if width > 0 and len(user_raw) > (width - 1):
        user_raw = user_raw[:width - 2] + "…"
    padded = f"{user_raw:<{width}}" if width > 0 else user_raw

    u_lower = user_raw.lower()
    if CURRENT_USER and u_lower == CURRENT_USER.lower():
        return f"{BOLD}{BRIGHT_GREEN}{padded}{RESET}"
    elif u_lower in ["root"]:
        return f"{BOLD}{BRIGHT_RED}{padded}{RESET}"
    elif user_raw.isdigit():
        return f"{BOLD}{BRIGHT_YELLOW}{padded}{RESET}"
    elif u_lower in ["systemd", "daemon", "dbus", "nobody", "polkitd", "bin", "sys"]:
        return f"{PURPLE}{padded}{RESET}"
    else:
        return f"{SKY_BLUE}{padded}{RESET}"

def color_cpu(cpu_pct):
    if cpu_pct >= 50.0:
        return f"{BOLD}{BRIGHT_RED}{cpu_pct:5.1f}%{RESET}"
    elif cpu_pct >= 20.0:
        return f"{BOLD}{ORANGE}{cpu_pct:5.1f}%{RESET}"
    elif cpu_pct >= 5.0:
        return f"{BOLD}{BRIGHT_YELLOW}{cpu_pct:5.1f}%{RESET}"
    elif cpu_pct >= 1.0:
        return f"{ELECTRIC_CYAN}{cpu_pct:5.1f}%{RESET}"
    elif cpu_pct > 0.0:
        return f"{SKY_BLUE}{cpu_pct:5.1f}%{RESET}"
    else:
        return f"{DIM}{GRAY}{cpu_pct:5.1f}%{RESET}"

def render_mini_bar(percent, width=8):
    p = max(0.0, min(100.0, percent))
    filled = int(round((p / 100.0) * width))
    filled = min(width, max(0, filled))
    empty = width - filled

    if p >= 8.0:
        bar_col = BRIGHT_RED
    elif p >= 4.0:
        bar_col = ORANGE
    elif p >= 1.5:
        bar_col = BRIGHT_YELLOW
    elif p >= 0.5:
        bar_col = ELECTRIC_CYAN
    else:
        bar_col = GREEN

    return f"{bar_col}{'█' * filled}{BAR_EMPTY}{'░' * empty}{RESET} {p:4.1f}%"

def render_gauge(used, total, width=20):
    if total <= 0:
        pct = 0.0
    else:
        pct = (used / total) * 100.0
    pct = max(0.0, min(100.0, pct))
    filled = int(round((pct / 100.0) * width))
    filled = min(width, max(0, filled))
    empty = width - filled

    if pct >= 85.0:
        bar_col = BRIGHT_RED
    elif pct >= 70.0:
        bar_col = ORANGE
    elif pct >= 50.0:
        bar_col = BRIGHT_YELLOW
    else:
        bar_col = BRIGHT_GREEN

    return f"{bar_col}{'█' * filled}{BAR_EMPTY}{'░' * empty}{RESET} {BOLD}{WHITE}{pct:5.1f}%{RESET}"

def format_duration(seconds):
    if seconds < 60:
        return f"{int(seconds)}s"
    minutes = seconds / 60
    if minutes < 60:
        return f"{int(minutes)}m {int(seconds % 60)}s"
    hours = minutes / 60
    if hours < 24:
        return f"{int(hours)}h {int(minutes % 60)}m"
    days = hours / 24
    return f"{int(days)}d {int(hours % 24)}h"

def collect_processes(search=None, user=None, sort_by="rss", reverse=True):
    attrs = ["pid", "name", "username", "memory_info", "memory_percent", "cpu_times", "cpu_percent", "num_threads", "status", "cmdline", "create_time"]
    procs = []
    now = time.time()
    
    for p in psutil.process_iter(attrs):
        try:
            info = p.info
            mem_info = info.get("memory_info")
            if not mem_info:
                continue

            rss = getattr(mem_info, "rss", 0)
            vms = getattr(mem_info, "vms", 0)
            shared = getattr(mem_info, "shared", 0)
            mem_pct = info.get("memory_percent") or 0.0
            
            ctime = info.get("create_time") or now
            uptime = max(0.1, now - ctime)
            t = info.get("cpu_times")
            if t and uptime > 0.1:
                cpu_pct = ((t.user + t.system) / uptime) * 100.0
            else:
                cpu_pct = info.get("cpu_percent") or 0.0

            pid = info.get("pid")
            name = info.get("name") or "unknown"
            uname = info.get("username") or "unknown"
            threads = info.get("num_threads") or 1
            status = info.get("status") or "unknown"
            cmdline_list = info.get("cmdline") or []
            cmdline = " ".join(cmdline_list) if cmdline_list else f"[{name}]"

            # Filter by user
            if user and uname.lower() != user.lower():
                continue

            # Filter by search pattern
            if search:
                pattern = str(search).lower()
                matches = (
                    pattern in name.lower() or
                    pattern in cmdline.lower() or
                    pattern in uname.lower() or
                    pattern == str(pid)
                )
                if not matches:
                    continue

            procs.append({
                "pid": pid,
                "name": name,
                "username": uname,
                "rss": rss,
                "vms": vms,
                "shared": shared,
                "percent": mem_pct,
                "cpu_percent": cpu_pct,
                "num_threads": threads,
                "status": status,
                "cmdline": cmdline,
                "create_time": ctime
            })
        except (psutil.NoSuchProcess, psutil.AccessDenied, psutil.ZombieProcess):
            continue

    # Sort
    sort_key = sort_by.lower()
    if sort_key == "rss":
        procs.sort(key=lambda x: x["rss"], reverse=reverse)
    elif sort_key == "vms":
        procs.sort(key=lambda x: x["vms"], reverse=reverse)
    elif sort_key in ["cpu", "cpu_percent"]:
        procs.sort(key=lambda x: x["cpu_percent"], reverse=reverse)
    elif sort_key in ["percent", "mem"]:
        procs.sort(key=lambda x: x["percent"], reverse=reverse)
    elif sort_key in ["threads", "num_threads"]:
        procs.sort(key=lambda x: x["num_threads"], reverse=reverse)
    elif sort_key == "name":
        procs.sort(key=lambda x: x["name"].lower(), reverse=not reverse)
    elif sort_key == "pid":
        procs.sort(key=lambda x: x["pid"], reverse=not reverse)
    else:
        procs.sort(key=lambda x: x["rss"], reverse=True)

    return procs

def group_processes(proc_list):
    groups = {}
    for p in proc_list:
        key = p["name"]
        if key not in groups:
            groups[key] = {
                "name": key,
                "count": 0,
                "rss": 0,
                "vms": 0,
                "shared": 0,
                "percent": 0.0,
                "cpu_percent": 0.0,
                "threads": 0,
                "max_rss_pid": p["pid"],
                "max_rss_val": p["rss"],
                "pids": [],
                "sample_cmd": p["cmdline"]
            }
        g = groups[key]
        g["count"] += 1
        g["rss"] += p["rss"]
        g["vms"] += p["vms"]
        g["shared"] += p["shared"]
        g["percent"] += p["percent"]
        g["cpu_percent"] += p["cpu_percent"]
        g["threads"] += p["num_threads"]
        g["pids"].append(p["pid"])
        if p["rss"] > g["max_rss_val"]:
            g["max_rss_val"] = p["rss"]
            g["max_rss_pid"] = p["pid"]
            g["sample_cmd"] = p["cmdline"]

    res = list(groups.values())
    res.sort(key=lambda x: x["rss"], reverse=True)
    return res

