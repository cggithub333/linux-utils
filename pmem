def format_fzf_proc_line(p):
    pid_str = f"{ELECTRIC_CYAN}{p['pid']:<7}{RESET}"
    user_str = color_user(p['username'], width=12)
    cpu_str = color_cpu(p["cpu_percent"])
    ram_str = color_ram(p["rss"], p["percent"], width=10)
    mem_bar = render_mini_bar(p["percent"], width=7)
    th_str = f"{GRAY}{p['num_threads']:>4}{RESET}"
    
    st = p["status"]
    if st == "running":
        st_str = f"{BRIGHT_GREEN}{'R':<3}{RESET}"
    elif st == "sleeping":
        st_str = f"{GRAY}{'S':<3}{RESET}"
    elif st in ["stopped", "zombie"]:
        st_str = f"{BRIGHT_RED}{st[:3]:<3}{RESET}"
    else:
        st_str = f"{YELLOW}{st[:3]:<3}{RESET}"

    name_raw = p["name"]
    if len(name_raw) > 17:
        name_raw = name_raw[:16] + "…"
    name_str = f"{BOLD}{WHITE}{name_raw:<18}{RESET}"
    cmd_str = f"{DIM}{p['cmdline']}{RESET}"
    return f"{pid_str} {user_str} {cpu_str}  {ram_str}  {mem_bar} {th_str} {st_str} {name_str} {cmd_str}"

def run_fzf_mode(procs, vmem):
    if not shutil.which("fzf"):
        print(f"{RED}Error: 'fzf' is not installed. Run 'sudo pacman -S fzf' or use standard output.{RESET}")
        return

    script_path = os.path.realpath(__file__)
    fzf_header = f"{BOLD}{ELECTRIC_CYAN}  {'PID':<7} {'USER':<12} {'CPU%':>6}  {'RAM (RSS)':>10}  {'%MEM (BAR)':<15} {'TH':>4} {'ST':<3} {'PROCESS':<18} COMMAND{RESET}"
    lines = [fzf_header]

    for p in procs:
        lines.append(f"  {format_fzf_proc_line(p)}")

    preview_cmd = f"{script_path} --inspect {{1}}"

    fzf_cmd = [
        "fzf",
        "--ansi",
        "--header-lines=1",
        "--layout=reverse",
        "--border=rounded",
        "--prompt=󰍛 RAM Explorer > ",
        "--header=[Enter] Inspect  │  [Ctrl-K] Kill (SIGTERM)  │  [Ctrl-9] Force Kill  │  [Ctrl-R] Refresh  │  [Esc] Exit",
        f"--preview={preview_cmd}",
        "--preview-window=right:55%:wrap:border-rounded",
        "--bind=shift-up:preview-up",
        "--bind=shift-down:preview-down",
        "--bind=page-up:preview-page-up",
        "--bind=page-down:preview-page-down",
        f"--bind=ctrl-k:execute(kill -15 {{1}} 2>/dev/null && notify-send 'Process Manager' 'Sent SIGTERM to PID {{1}}')+reload({script_path} --fzf-dump)",
        f"--bind=ctrl-9:execute(kill -9 {{1}} 2>/dev/null && notify-send 'Process Manager' 'Sent SIGKILL to PID {{1}}')+reload({script_path} --fzf-dump)",
        f"--bind=ctrl-r:reload({script_path} --fzf-dump)",
        "--bind=ctrl-y:execute(echo -n {1} | wl-copy 2>/dev/null || echo -n {1} | xclip -sel clip 2>/dev/null)",
    ]

    try:
        proc = subprocess.Popen(
            fzf_cmd,
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            text=True
        )
        selected_line, _ = proc.communicate(input="\n".join(lines))
        if proc.returncode == 0 and selected_line.strip():
            clean_line = ANSI_STRIP_REGEX.sub('', selected_line).strip()
            tokens = clean_line.split()
            if tokens:
                inspect_process(int(tokens[0]))
    except KeyboardInterrupt:
        pass

def fzf_dump_lines():
    procs = collect_processes(sort_by="rss")
    fzf_header = f"{BOLD}{ELECTRIC_CYAN}  {'PID':<7} {'USER':<12} {'CPU%':>6}  {'RAM (RSS)':>10}  {'%MEM (BAR)':<15} {'TH':>4} {'ST':<3} {'PROCESS':<18} COMMAND{RESET}"
    print(fzf_header)
    for p in procs:
        print(f"  {format_fzf_proc_line(p)}")

def main():
    parser = argparse.ArgumentParser(
        description="pmem: Universal Smart, Fast & Beautiful Process Memory Explorer & RAM Profiler",
        formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument("-n", "--limit", "--top", default=30, help="Number of processes to display (default: 30; 0 or 'all' for unlimited)")
    parser.add_argument("-g", "--group", action="store_true", help="Group by application name and sum memory usage")
    parser.add_argument("-s", "--search", help="Filter processes by name, PID, user, or command line regex/keyword")
    parser.add_argument("-u", "--user", help="Filter processes by username")
    parser.add_argument("-w", "--watch", nargs="?", const=2.0, type=float, help="Live watch mode with refresh interval in seconds (default: 2.0)")
    parser.add_argument("-i", "--fzf", "--interactive", action="store_true", help="Launch interactive FZF browser with live preview and process controls")
    parser.add_argument("-f", dest="fzf_alias", action="store_true", help="Alias for -i / --fzf")
    parser.add_argument("-c", "--color", choices=["auto", "always", "never"], default="auto", help="Color output mode (auto, always, never; default: auto)")
    parser.add_argument("--sort", choices=["rss", "vms", "cpu", "percent", "threads", "name", "pid"], default="rss", help="Sorting field (default: rss)")
    parser.add_argument("--asc", action="store_true", help="Sort in ascending order (default: descending)")
    parser.add_argument("--inspect", type=int, help="Display comprehensive resource breakdown for a specific PID")
    parser.add_argument("--json", action="store_true", help="Output machine-readable JSON")
    parser.add_argument("--no-color", action="store_true", help="Disable ANSI color codes")
    parser.add_argument("--fzf-dump", action="store_true", help=argparse.SUPPRESS)

    args = parser.parse_args()

    # Color mode handling
    if args.color == "never" or args.no_color:
        disable_colors()
    elif args.color == "always":
        pass  # Preserve colors even through pipes
    elif not sys.stdout.isatty() and not (args.json or args.inspect or args.fzf_dump):
        disable_colors()

    # Consolidate fzf flag
    if getattr(args, "fzf_alias", False):
        args.fzf = True

    # Internal helper for FZF reloading
    if args.fzf_dump:
        fzf_dump_lines()
        return

    # Single PID inspect mode
    if args.inspect is not None:
        inspect_process(args.inspect)
        return

    # Parse limit
    limit = 30
    if args.limit:
        if str(args.limit).lower() in ["0", "all", "none", "unlimited"]:
            limit = None
        else:
            try:
                limit = int(args.limit)
            except ValueError:
                limit = 30

    reverse_sort = not args.asc

    # Interactive FZF Mode
    if args.fzf:
        vmem = psutil.virtual_memory()
        procs = collect_processes(search=args.search, user=args.user, sort_by=args.sort, reverse=reverse_sort)
        run_fzf_mode(procs, vmem)
        return

    # Live Watch Mode
    if args.watch is not None:
        interval = max(0.5, args.watch)
        try:
            while True:
                vmem = psutil.virtual_memory()
                swap = psutil.swap_memory()
                procs = collect_processes(search=args.search, user=args.user, sort_by=args.sort, reverse=reverse_sort)
                running_tasks = sum(1 for p in procs if p["status"] == "running")

                print(f"{ESC}[2J{ESC}[H", end="", flush=True)
                print_system_header(vmem, swap, len(procs), running_tasks)
                
                if args.group:
                    groups = group_processes(procs)
                    render_group_table(groups, vmem, limit=limit)
                else:
                    render_table(procs, vmem, limit=limit)

                print(f"{GRAY}  Refreshing every {interval:.1f}s │ Press Ctrl+C to exit{RESET}", flush=True)
                time.sleep(interval)
        except KeyboardInterrupt:
            print(f"\n{GRAY}Exited live watch mode.{RESET}")
            return

    # Standard Execution
    vmem = psutil.virtual_memory()
    swap = psutil.swap_memory()
    procs = collect_processes(search=args.search, user=args.user, sort_by=args.sort, reverse=reverse_sort)

    if args.json:
        if args.group:
            data = group_processes(procs)
        else:
            data = procs
        output_payload = {
            "timestamp": datetime.datetime.now().isoformat(),
            "system_memory": {
                "total_bytes": vmem.total,
                "used_bytes": vmem.used,
                "available_bytes": vmem.available,
                "percent": vmem.percent
            },
            "system_swap": {
                "total_bytes": swap.total,
                "used_bytes": swap.used,
                "percent": swap.percent
            },
            "processes_count": len(procs),
            "results": data if (limit is None) else data[:limit]
        }
        print(json.dumps(output_payload, indent=2))
        return

    running_tasks = sum(1 for p in procs if p["status"] == "running")
    print_system_header(vmem, swap, len(procs), running_tasks)

    if args.group:
        groups = group_processes(procs)
        render_group_table(groups, vmem, limit=limit)
    else:
        render_table(procs, vmem, limit=limit)

if __name__ == "__main__":
    main()
