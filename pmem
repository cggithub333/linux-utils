def inspect_process(pid):
    try:
        p = psutil.Process(pid)
    except psutil.NoSuchProcess:
        print(f"{RED}Error: Process with PID {pid} does not exist.{RESET}")
        return
    except psutil.AccessDenied:
        print(f"{RED}Error: Access denied to process {pid}. Try with sudo.{RESET}")
        return

    try:
        name = p.name()
        uids = p.uids()
        uname = p.username()
        status = p.status()
        ctime = p.create_time()
        uptime = format_duration(time.time() - ctime)
        started_str = datetime.datetime.fromtimestamp(ctime).strftime("%Y-%m-%d %H:%M:%S")

        mem = p.memory_info()
        mem_pct = p.memory_percent()
        cpu_pct = p.cpu_percent(interval=None)
        cpu_times = p.cpu_times()
        threads = p.num_threads()

        try:
            cmdline = " ".join(p.cmdline())
        except (psutil.AccessDenied, psutil.ZombieProcess):
            cmdline = f"[{name}]"

        try:
            exe = p.exe()
        except (psutil.AccessDenied, psutil.ZombieProcess):
            exe = "N/A (restricted)"

        try:
            cwd = p.cwd()
        except (psutil.AccessDenied, psutil.ZombieProcess):
            cwd = "N/A (restricted)"

        try:
            parent = p.parent()
            parent_str = f"{parent.name()} (PID {parent.pid})" if parent else "None (root/init)"
        except Exception:
            parent_str = "Unknown"

        try:
            num_fds = p.num_fds() if hasattr(p, "num_fds") else len(p.open_files())
        except Exception:
            num_fds = "N/A"

        vmem = psutil.virtual_memory()
        mem_bar = render_mini_bar(mem_pct, width=16)

        print(f"\n{BOLD}{ELECTRIC_CYAN}╭─────────────────────────────────────────────────────────────╮{RESET}")
        print(f"{BOLD}{ELECTRIC_CYAN}│  󰄛 Process Deep Inspection: {name:<30} │{RESET}")
        print(f"{BOLD}{ELECTRIC_CYAN}╰─────────────────────────────────────────────────────────────╯{RESET}")
        print(f"  {GRAY}PID:{RESET}            {BOLD}{WHITE}{p.pid}{RESET}  {GRAY}(Parent: {parent_str}){RESET}")
        print(f"  {GRAY}User:{RESET}           {color_user(uname, width=0)} {GRAY}(UID: {uids.real}){RESET}")
        print(f"  {GRAY}Status:{RESET}         {BRIGHT_GREEN if status == 'running' else YELLOW}{status.upper()}{RESET}")
        print(f"  {GRAY}Started:{RESET}        {WHITE}{started_str}{RESET} {GRAY}(Active for: {uptime}){RESET}")
        print(f"  {GRAY}Binary Path:{RESET}    {SKY_BLUE}{exe}{RESET}")
        print(f"  {GRAY}Working Dir:{RESET}    {SKY_BLUE}{cwd}{RESET}")
        print(f"\n  {BOLD}{WHITE}Memory Breakdown:{RESET}")
        print(f"    • {GRAY}Physical RAM (RSS):{RESET}    {color_ram(mem.rss, mem_pct)}")
        print(f"    • {GRAY}System RAM Share:{RESET}      {mem_bar}")
        print(f"    • {GRAY}Virtual Memory (VMS):{RESET}  {format_bytes(mem.vms)}")
        print(f"    • {GRAY}Shared Memory:{RESET}         {format_bytes(getattr(mem, 'shared', 0))}")
        print(f"    • {GRAY}Data / Dirty Pages:{RESET}    {format_bytes(getattr(mem, 'data', 0))} / {format_bytes(getattr(mem, 'dirty', 0))}")
        print(f"\n  {BOLD}{WHITE}Performance & Resources:{RESET}")
        print(f"    • {GRAY}CPU Usage:{RESET}             {color_cpu(cpu_pct)}")
        print(f"    • {GRAY}CPU Time (User/Sys):{RESET}   {cpu_times.user:.2f}s user, {cpu_times.system:.2f}s system")
        print(f"    • {GRAY}Active Threads:{RESET}        {WHITE}{threads}{RESET}")
        print(f"    • {GRAY}Open File Handles:{RESET}     {WHITE}{num_fds}{RESET}")
        print(f"\n  {BOLD}{WHITE}Full Command Line:{RESET}")
        print(f"    {DIM}{cmdline}{RESET}\n")

    except Exception as e:
        print(f"{RED}Error inspecting process {pid}: {e}{RESET}")

